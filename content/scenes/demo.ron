// Aşama 0 deneme sahnesi: örnek çizimlerin dizilimi.
// Konumlar mantıksal piksel (1920×1080). Paralaks: kamera kayınca katmanın ne kadar kaydığı.
(
    layers: [
        (art: "art/samples/landscape/1-gok.svg", parallax: 0.05),
        (art: "art/samples/landscape/2-uzak.svg", parallax: 0.15),
        (art: "art/samples/landscape/3-orta.svg", parallax: 0.35),
        (art: "art/samples/landscape/4-yakin.svg", parallax: 0.65),
        (art: "art/samples/landscape/5-zemin.svg", parallax: 1.0),
    ],
    // Katmanların sol kenarı, kamera sıfırdayken (katmanlar ekrandan geniştir).
    layer_origin: (-320, 0),
    actors: [
        (art: "art/samples/soldier.svg", anchor: (150, 500), position: (250, 920), scale: 0.68),
        (art: "art/samples/soldier.svg", anchor: (150, 500), position: (790, 928), scale: 0.66),
        (art: "art/samples/hero.svg", anchor: (186, 500), position: (520, 1004), scale: 0.88),
    ],
    shadow: "art/samples/shadow.svg",
    foreground: (art: "art/samples/landscape/6-on.svg", parallax: 1.3),
    window: (art: "art/samples/window.svg", position: (1150, 300), scale: 0.88),
    window_texts: [
        (key: "shop_title", font: Title, size: 44, color: "#F1E3C2", position: (190, 24), width: 420, align: Center),
        (key: "item_name", font: Heading, size: 34, color: "#2E2116", position: (440, 140), width: 270, align: Left),
        (key: "item_text", font: Body, size: 23, color: "#2E2116", position: (440, 224), width: 270, align: Left),
        (key: "item_price", font: Small, size: 22, color: "#6B5A44", position: (300, 380), width: 230, align: Center),
        (key: "button_buy", font: Title, size: 30, color: "#F1E3C2", position: (588, 376), width: 80, align: Center),
    ],
)
