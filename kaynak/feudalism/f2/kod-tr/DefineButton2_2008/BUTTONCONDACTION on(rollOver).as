on(rollOver){
   item_name_txt.text = "Cengiz, Kara Orda'nın Hanı";
   item_stats_txt.text = "Yakın dövüş ve menzilli silahları ustalıkla birleştirir. Tek elli silahlar, yaylar ve iki elli kılıçlarla özel hareketler öğrenebilir. Okçuları, kılıççıları ve süvariyi güçlendirmede uzmandır. Düşmanı bastırabilir ve askerlerini destekleyebilir.";
   item_stats_txt.text += "\nOrda savaşçıları çevikliklerine, güçlerine ve ruh güçlerine güvenir. Düşmanı uzaktan okla vurmayı, sağ kalanları da yakın dövüşte öldürmeyi severler.\nNot: Orda kılıç, hançer ve yay üretir. Yayları dünyanın en iyilerindendir.";
}
