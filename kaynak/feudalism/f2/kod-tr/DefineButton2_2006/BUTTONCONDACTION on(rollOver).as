on(rollOver){
   item_name_txt.text = "Inga, Kara Orda'nın Baş Şamanı";
   item_stats_txt.text = "Büyük bir yay ustası ve tek başına da etkili bir savaşçı. Yay, hançer ve tek elli silahlarla özel hareketler öğrenebilir. Okçuları ve süvariyi güçlendirmede uzmandır. Düşmanı bastırabilir ve kendini iyileştirebilir.";
   item_stats_txt.text += "\nOrda savaşçıları çevikliklerine, güçlerine ve ruh güçlerine güvenir. Düşmanı uzaktan okla vurmayı, sağ kalanları da yakın dövüşte öldürmeyi severler.\nNot: Orda kılıç, hançer ve yay üretir. Yayları dünyanın en iyilerindendir.";
}
